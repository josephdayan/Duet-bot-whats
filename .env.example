# Copie estes nomes para Settings > Environment Variables no Vercel (não coloque valores reais neste arquivo).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
GMAIL_USER=seu-email@gmail.com
GMAIL_APP_PASSWORD=
# Opcional: para onde mandar (padrão: GMAIL_USER)
MAIL_TO=
# Obrigatório: números autorizados, separados por vírgula, no formato do Twilio
ALLOWED_FROM=whatsapp:+5511999999999
# Opcional: minutos de silêncio que encerram uma conversa no mesmo fio do Gmail (padrão 30; 0 desliga)
CONTEXT_GAP_MINUTES=30
# Opcional: 1 para o bot responder "✓" a cada mensagem (custa US$0,005 por resposta)
REPLY_ACK=0
# Opcional: URL pública exata configurada no Twilio, se a validação da assinatura falhar atrás de proxy/domínio próprio
PUBLIC_URL=
